{
  "name": "sriramkancherla-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio monorepo — frontend (Next.js), backend (Cloudflare Worker), data (documents and assets).",
  "scripts": {
    "prebuild": "npm ci --prefix frontend",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run pages:build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "deploy": "npm --prefix frontend run deploy",
    "sync:documents": "npm --prefix frontend run sync:documents",
    "backend:dev": "npm --prefix backend run dev",
    "backend:deploy": "npm --prefix backend run deploy",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "install:all": "npm --prefix frontend install && npm --prefix backend install"
  },
  "engines": {
    "node": ">=20"
  }
}
