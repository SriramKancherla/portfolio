# Public site URL (no trailing slash) — sitemap, canonical, Open Graph at build time
NEXT_PUBLIC_SITE_URL=https://sriramkancherla.pages.dev

# Web3Forms access key — set as a Cloudflare Worker secret (runtime):
#   wrangler secret put WEB3FORMS_ACCESS_KEY
# Or Cloudflare dashboard → Workers → sriramkancherla → Settings → Variables
# Local preview: add WEB3FORMS_ACCESS_KEY=... to .dev.vars
# Do NOT prefix with NEXT_PUBLIC_ — that would embed the key in the client bundle.
