# Public site URL (no trailing slash) — sitemap, canonical, Open Graph at build time
NEXT_PUBLIC_SITE_URL=https://sriramkancherla.pages.dev

# Web3Forms access key — used by the contact form.
#
# This one IS public on purpose. Web3Forms refuses server-side submissions on
# the free plan ("Use our API in client side..."), so the browser posts to them
# directly and the key ships in the client bundle. That is their intended model.
#
# Protect it in the Web3Forms dashboard instead: restrict the key to your own
# domains so nobody else's page can submit with it.
#
# NEXT_PUBLIC_ values are inlined at BUILD time, not read at runtime — so this
# must be set wherever `npm run build` runs, not as a Cloudflare Worker secret.
#   Local: put it in .env.local
#   Deploy: it is picked up from .env.local when you run `npm run deploy`
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
